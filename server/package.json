{
  "name": "@pulsewatch/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "node --watch src/server.js",
    "dev:worker": "node --watch src/worker.js",
    "dev:scheduler": "node --watch src/scheduler.js",
    "start:api": "node src/server.js",
    "start:worker": "node src/worker.js",
    "start:scheduler": "node src/scheduler.js",
    "check": "node --check src/server.js && node --check src/worker.js && node --check src/scheduler.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
